<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="pixelConquest.StrategyCreatorView">
    <Panel Background="#1e1e22">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <TextBlock Text="Création de stratégie (à venir)" FontSize="24"
                       Foreground="#f1faee" HorizontalAlignment="Center" />
            <Button x:Name="BackButton" Content="← Retour au menu"
                    HorizontalAlignment="Center" />
        </StackPanel>
    </Panel>
</UserControl>
