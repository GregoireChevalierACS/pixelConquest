<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="pixelConquest.MainWindow"
        Title="pixelConquest"
        Width="900" Height="600"
        Background="#1e1e22">

    <DockPanel>
        <!-- Barre d'état en bas : tick + score -->
        <Border DockPanel.Dock="Bottom" Background="#2a2a30" Padding="10,6">
            <TextBlock x:Name="StatusText" Foreground="#dddddd"
                       FontFamily="Consolas,monospace" Text="Prêt." />
        </Border>

        <!-- Zone de rendu de la grille -->
        <Panel x:Name="GridHost" Margin="10" />
    </DockPanel>
</Window>
